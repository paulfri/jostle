{
  "$schema": "../../schemas/gesture-case.schema.json",
  "schemaVersion": 1,
  "id": "gesture.resize-top-left",
  "title": "Resize from the top-left region while preserving opposite edges",
  "behaviorIds": ["RESIZE-001", "RESIZE-008", "RESIZE-009", "GEO-003", "GEO-005", "GEO-010"],
  "mode": "parity",
  "given": {
    "configuration": {
      "sessionActive": true,
      "overallEnabled": true,
      "requiredModifiers": ["control", "command"],
      "bringToFront": false,
      "middleClickResize": false,
      "resizeOnly": false,
      "moveThrottleNanoseconds": 16666667,
      "resizeThrottleNanoseconds": 16666667
    },
    "initialState": {
      "kind": "idle",
      "gesture": null
    }
  },
  "steps": [
    {
      "event": {
        "type": "mouseDown",
        "timestampNanoseconds": 2000000000,
        "modifiers": ["control", "command"],
        "button": "right",
        "pointer": { "x": 110, "y": 210 },
        "target": {
          "outcome": "usable",
          "windowId": "window-1",
          "applicationId": "app-1",
          "appKey": "com.example.App",
          "frame": { "x": 100, "y": 200, "width": 600, "height": 300 }
        }
      },
      "expected": {
        "state": {
          "kind": "resizing",
          "gesture": {
            "windowId": "window-1",
            "applicationId": "app-1",
            "frame": { "x": 100, "y": 200, "width": 600, "height": 300 },
            "horizontalEdge": "left",
            "verticalEdge": "top",
            "lastWriteTimeNanoseconds": 2000000000
          }
        },
        "commands": [],
        "disposition": "consume",
        "diagnostics": []
      }
    },
    {
      "event": {
        "type": "mouseDragged",
        "timestampNanoseconds": 2020000000,
        "modifiers": ["control", "command"],
        "button": "right",
        "delta": { "x": -20, "y": -10 }
      },
      "expected": {
        "state": {
          "kind": "resizing",
          "gesture": {
            "windowId": "window-1",
            "applicationId": "app-1",
            "frame": { "x": 80, "y": 190, "width": 620, "height": 310 },
            "horizontalEdge": "left",
            "verticalEdge": "top",
            "lastWriteTimeNanoseconds": 2020000000
          }
        },
        "commands": [
          {
            "type": "setPosition",
            "windowId": "window-1",
            "position": { "x": 80, "y": 190 }
          },
          {
            "type": "setSize",
            "windowId": "window-1",
            "size": { "width": 620, "height": 310 }
          }
        ],
        "disposition": "consume",
        "diagnostics": []
      }
    },
    {
      "event": {
        "type": "mouseUp",
        "timestampNanoseconds": 2021000000,
        "modifiers": ["control", "command"],
        "button": "right"
      },
      "expected": {
        "state": { "kind": "idle", "gesture": null },
        "commands": [],
        "disposition": "consume",
        "diagnostics": []
      }
    }
  ]
}
