{
  "$schema": "../../schemas/gesture-case.schema.json",
  "schemaVersion": 1,
  "id": "gesture.overall-disable-cancels",
  "title": "Disabling Jostle cancels an active gesture",
  "behaviorIds": ["PREF-009", "END-006"],
  "mode": "parity",
  "given": {
    "configuration": {
      "sessionActive": true,
      "overallEnabled": true,
      "requiredModifiers": ["control", "command"],
      "bringToFront": false,
      "middleClickResize": false,
      "resizeOnly": false,
      "moveThrottleNanoseconds": 16666667,
      "resizeThrottleNanoseconds": 16666667
    },
    "initialState": { "kind": "idle", "gesture": null }
  },
  "steps": [
    {
      "event": {
        "type": "mouseDown",
        "timestampNanoseconds": 7000000000,
        "modifiers": ["control", "command"],
        "button": "left",
        "pointer": { "x": 250, "y": 350 },
        "target": {
          "outcome": "usable",
          "windowId": "window-1",
          "applicationId": "app-1",
          "appKey": "com.example.App",
          "frame": { "x": 100, "y": 200, "width": 800, "height": 600 }
        }
      },
      "expected": {
        "state": {
          "kind": "moving",
          "gesture": {
            "windowId": "window-1",
            "applicationId": "app-1",
            "frame": { "x": 100, "y": 200, "width": 800, "height": 600 },
            "horizontalEdge": "none",
            "verticalEdge": "none",
            "lastWriteTimeNanoseconds": 7000000000
          }
        },
        "commands": [],
        "disposition": "consume",
        "diagnostics": []
      }
    },
    {
      "event": {
        "type": "overallDisabled",
        "timestampNanoseconds": 7001000000,
        "modifiers": []
      },
      "expected": {
        "state": { "kind": "idle", "gesture": null },
        "commands": [],
        "disposition": "notApplicable",
        "diagnostics": []
      }
    },
    {
      "event": {
        "type": "mouseDown",
        "timestampNanoseconds": 7002000000,
        "modifiers": ["control", "command"],
        "button": "left",
        "pointer": { "x": 250, "y": 350 },
        "target": {
          "outcome": "usable",
          "windowId": "window-2",
          "applicationId": "app-1",
          "appKey": "com.example.App",
          "frame": { "x": 300, "y": 400, "width": 500, "height": 300 }
        }
      },
      "expected": {
        "state": { "kind": "idle", "gesture": null },
        "commands": [],
        "disposition": "passThrough",
        "diagnostics": []
      }
    }
  ]
}
