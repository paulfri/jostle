{
  "$schema": "../../schemas/gesture-case.schema.json",
  "schemaVersion": 1,
  "id": "gesture.move-basic",
  "title": "Move a window after the throttle interval",
  "behaviorIds": ["EVT-005", "HIT-014", "MOVE-001", "MOVE-004", "MOVE-006", "END-001"],
  "mode": "parity",
  "given": {
    "configuration": {
      "sessionActive": true,
      "overallEnabled": true,
      "requiredModifiers": ["control", "command"],
      "bringToFront": false,
      "middleClickResize": false,
      "resizeOnly": false,
      "moveThrottleNanoseconds": 16666667,
      "resizeThrottleNanoseconds": 16666667
    },
    "initialState": {
      "kind": "idle",
      "gesture": null
    }
  },
  "steps": [
    {
      "event": {
        "type": "mouseDown",
        "timestampNanoseconds": 1000000000,
        "modifiers": ["control", "command"],
        "button": "left",
        "pointer": { "x": 250, "y": 350 },
        "target": {
          "outcome": "usable",
          "windowId": "window-1",
          "applicationId": "app-1",
          "appKey": "com.example.App",
          "frame": { "x": 100, "y": 200, "width": 800, "height": 600 }
        }
      },
      "expected": {
        "state": {
          "kind": "moving",
          "gesture": {
            "windowId": "window-1",
            "applicationId": "app-1",
            "frame": { "x": 100, "y": 200, "width": 800, "height": 600 },
            "horizontalEdge": "none",
            "verticalEdge": "none",
            "lastWriteTimeNanoseconds": 1000000000
          }
        },
        "commands": [],
        "disposition": "consume",
        "diagnostics": []
      }
    },
    {
      "event": {
        "type": "mouseDragged",
        "timestampNanoseconds": 1020000000,
        "modifiers": ["control", "command"],
        "button": "left",
        "delta": { "x": 12, "y": -7 }
      },
      "expected": {
        "state": {
          "kind": "moving",
          "gesture": {
            "windowId": "window-1",
            "applicationId": "app-1",
            "frame": { "x": 112, "y": 193, "width": 800, "height": 600 },
            "horizontalEdge": "none",
            "verticalEdge": "none",
            "lastWriteTimeNanoseconds": 1020000000
          }
        },
        "commands": [
          {
            "type": "setPosition",
            "windowId": "window-1",
            "position": { "x": 112, "y": 193 }
          }
        ],
        "disposition": "consume",
        "diagnostics": []
      }
    },
    {
      "event": {
        "type": "mouseUp",
        "timestampNanoseconds": 1021000000,
        "modifiers": ["control", "command"],
        "button": "left"
      },
      "expected": {
        "state": {
          "kind": "idle",
          "gesture": null
        },
        "commands": [],
        "disposition": "consume",
        "diagnostics": []
      }
    }
  ]
}
