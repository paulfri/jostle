{
  "$schema": "../../schemas/gesture-case.schema.json",
  "schemaVersion": 1,
  "id": "gesture.move-release-modifiers-final-flush",
  "title": "Release modifiers before mouse-up and flush pending movement",
  "behaviorIds": ["MOVE-003", "MOVE-009", "END-001", "END-004"],
  "mode": "parity",
  "given": {
    "configuration": {
      "sessionActive": true,
      "overallEnabled": true,
      "requiredModifiers": ["control", "command"],
      "bringToFront": false,
      "middleClickResize": false,
      "resizeOnly": false,
      "moveThrottleNanoseconds": 16666667,
      "resizeThrottleNanoseconds": 16666667
    },
    "initialState": { "kind": "idle", "gesture": null }
  },
  "steps": [
    {
      "event": {
        "type": "mouseDown",
        "timestampNanoseconds": 4000000000,
        "modifiers": ["control", "command"],
        "button": "left",
        "pointer": { "x": 250, "y": 350 },
        "target": {
          "outcome": "usable",
          "windowId": "window-1",
          "applicationId": "app-1",
          "appKey": "com.example.App",
          "frame": { "x": 100, "y": 200, "width": 800, "height": 600 }
        }
      },
      "expected": {
        "state": {
          "kind": "moving",
          "gesture": {
            "windowId": "window-1",
            "applicationId": "app-1",
            "frame": { "x": 100, "y": 200, "width": 800, "height": 600 },
            "horizontalEdge": "none",
            "verticalEdge": "none",
            "lastWriteTimeNanoseconds": 4000000000
          }
        },
        "commands": [],
        "disposition": "consume",
        "diagnostics": []
      }
    },
    {
      "event": {
        "type": "mouseDragged",
        "timestampNanoseconds": 4005000000,
        "modifiers": ["control", "command"],
        "button": "left",
        "delta": { "x": 4, "y": 3 }
      },
      "expected": {
        "state": {
          "kind": "moving",
          "gesture": {
            "windowId": "window-1",
            "applicationId": "app-1",
            "frame": { "x": 104, "y": 203, "width": 800, "height": 600 },
            "horizontalEdge": "none",
            "verticalEdge": "none",
            "lastWriteTimeNanoseconds": 4000000000
          }
        },
        "commands": [],
        "disposition": "consume",
        "diagnostics": []
      }
    },
    {
      "event": {
        "type": "mouseUp",
        "timestampNanoseconds": 4006000000,
        "modifiers": [],
        "button": "left"
      },
      "expected": {
        "state": { "kind": "idle", "gesture": null },
        "commands": [
          {
            "type": "setPosition",
            "windowId": "window-1",
            "position": { "x": 104, "y": 203 }
          }
        ],
        "disposition": "consume",
        "diagnostics": []
      }
    }
  ]
}
