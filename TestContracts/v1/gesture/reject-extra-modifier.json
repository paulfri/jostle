  "steps": [
    {
      "event": {
        "type": "mouseDown",
        "timestampNanoseconds": 3000000000,
        "modifiers": ["control", "shift", "command"],
        "button": "left",
        "pointer": { "x": 250, "y": 350 },
        "target": {
          "outcome": "usable",
          "windowId": "window-1",
          "applicationId": "app-1",
          "appKey": "com.example.App",
          "frame": { "x": 100, "y": 200, "width": 800, "height": 600 }
        }
      },
      "expected": {
        "state": { "kind": "idle", "gesture": null },
        "commands": [],
        "disposition": "passThrough",
        "diagnostics": []
      }
    }
  ]
